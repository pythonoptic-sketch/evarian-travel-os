# Evarian Travel OS API runtime.
# Never commit the filled file.
#
# Copy Evarian values to /etc/evarian/evarian-api.env on the backend server.
DATA_DIR=/var/lib/evarian
EVARIAN_DATABASE_PATH=/var/lib/evarian/evarian.sqlite3

EVARIAN_MODEL_AGENTS_ENABLED=true
EVARIAN_MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Optional fallback provider.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Amadeus Self-Service supplier API.
# Keep these on the server only. The frontend must call backend routes.
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
EVARIAN_SUPPLIER_SIDE_EFFECTS_ENABLED=false

# Optional Pro membership billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PRO_SUCCESS_URL=https://drinknile.com/#track
PRO_CANCEL_URL=https://drinknile.com/#operating-model
