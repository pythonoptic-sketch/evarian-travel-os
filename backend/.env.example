# Evarian backend development environment.
# Copy to a private .env or /etc/evarian/evarian-api.env. Never commit filled secrets.

DATA_DIR=/var/lib/evarian
EVARIAN_DATABASE_PATH=/var/lib/evarian/evarian.sqlite3

# Model-backed agent enrichment.
# The deterministic policy and trip-order engine works without a model key.
EVARIAN_MODEL_AGENTS_ENABLED=true
EVARIAN_MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Optional Google Gemini provider.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Amadeus Self-Service supplier rail.
# Current implementation supports flight-offer search only.
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Must remain false until supplier contracts, ticketing/payment authority,
# traveler approval UX, and production runbooks are ready.
EVARIAN_SUPPLIER_SIDE_EFFECTS_ENABLED=false

# Optional Stripe placeholders for future payment authority.
# Current backend does not charge cards or execute bookings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PRO_SUCCESS_URL=https://drinknile.com/#work
PRO_CANCEL_URL=https://drinknile.com/#work
